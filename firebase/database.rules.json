{
  "rules": {
    ".read": false,
    ".write": false,
    "auth": {
      "owner": {
        ".read": "auth != null && auth.token.email_verified == true",
        ".write": "auth != null && auth.token.email_verified == true && (!data.exists() || data.val() == auth.token.email.toLowerCase().replace('.', ','))",
        ".validate": "newData.isString() && newData.val() == auth.token.email.toLowerCase().replace('.', ',')"
      },
      "invites": {
        ".read": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ','))",
        ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ','))",
        "$key": {
          ".read": "auth != null && auth.token.email_verified == true && $key == auth.token.email.toLowerCase().replace('.', ',')",
          ".validate": "newData.hasChildren(['actorId', 'email']) && newData.child('actorId').isString()"
        }
      }
    },
    "registry": {
      ".read": true,
      "users": {
        ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ','))",
        "$actor": {
          "status": {
            ".write": true,
            ".validate": "(newData.val() == 'online' || newData.val() == 'offline') && root.child('registry/users').child($actor).child('name').exists()"
          }
        }
      },
      "modes": {
        ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ','))"
      }
    },
    "users": {
      ".read": true,
      ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ','))"
    },
    "terminal": {
      "archives": {
        ".read": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || (auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ','))"
      },
      "live": {
        ".read": true,
        "$actor": {
          ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || (auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() == $actor) || ((auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && root.child('relog/overlay').child($actor).child('muted').val() != true)"
        }
      }
    },
    "relog": {
      "overlay": {
        ".read": true,
        "$actor": {
          ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || (auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() == $actor)",
          "muted": {
            ".validate": "newData.isBoolean()"
          },
          "gifZone": {
            "cell": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
            },
            "height": {
              ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 900"
            },
            "seconds": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30"
            },
            "$other": {
              ".validate": false
            }
          },
          "room": {
            ".validate": "newData.isString() && root.child('relog/rooms').child(newData.val()).exists()"
          },
          "videoVolume": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          }
        }
      },
      "gifs": {
        ".read": true,
        "$target": {
          "$id": {
            ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || (!data.exists() && (auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && newData.child('from').val() == root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() && root.child('relog/overlay').child($target).child('muted').val() != true && root.child('registry/users').child($target).child('name').exists()) || (!newData.exists() && (data.child('from').val() == root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() || (auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() == $target)))",
            ".validate": "newData.hasChildren(['url', 'from', 'fromName', 'color', 'ts'])",
            "url": {
              ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^https:\\/\\/(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com|cdn\\.discordapp\\.com|media\\.discordapp\\.net|i\\.imgur\\.com)\\//)"
            },
            "preview": {
              ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^https:\\/\\/(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com|cdn\\.discordapp\\.com|media\\.discordapp\\.net|i\\.imgur\\.com)\\//)"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "from": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "fromName": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{3,8}$/)"
            },
            "caption": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
            },
            "$other": {
              ".validate": false
            },
            "sticker": {
              ".validate": "newData.isBoolean()"
            }
          }
        }
      },
      "favorites": {
        "$actor": {
          ".read": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || (auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() == $actor)",
          ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || (auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() == $actor)",
          "$fav": {
            ".validate": "newData.hasChildren(['url', 'addedAt'])",
            "url": {
              ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^https:\\/\\/(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com|cdn\\.discordapp\\.com|media\\.discordapp\\.net|i\\.imgur\\.com)\\//)"
            },
            "preview": {
              ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^https:\\/\\/(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com|cdn\\.discordapp\\.com|media\\.discordapp\\.net|i\\.imgur\\.com)\\//)"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "addedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            },
            "sticker": {
              ".validate": "newData.isBoolean()"
            }
          }
        }
      },
      "settings": {
        "giphyKey": {
          ".read": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || (auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
          ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ','))",
          ".validate": "newData.isString() && newData.val().length <= 100"
        }
      },
      "rooms": {
        ".read": true,
        "$room": {
          ".write": "(!data.exists() && (auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && newData.child('by').val() == root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val()) || (!newData.exists() && ((auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || data.child('by').val() == root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val()))",
          ".validate": "newData.hasChildren(['name', 'by', 'createdAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().length >= 1"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "roomContent": {
        ".read": true,
        "$room": {
          ".write": "!newData.exists() && ((auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || root.child('relog/rooms').child($room).child('by').val() == root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val())",
          "strokes": {
            "$id": {
              ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || ((auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && root.child('relog/overlay').child(root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val()).child('room').val() == $room && (!newData.exists() || (newData.child('by').val() == root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() && (!data.exists() || data.child('by').val() == root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val()))))",
              ".validate": "newData.hasChildren(['by', 'color', 'width', 'pts', 'fade', 'ts', 'done'])",
              "by": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "color": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{3,8}$/)"
              },
              "width": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60"
              },
              "pts": {
                ".validate": "newData.isString() && newData.val().length <= 20000"
              },
              "fade": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
              },
              "ts": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "end": {
                ".validate": "newData.isNumber()"
              },
              "done": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "items": {
            "$id": {
              ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || ((auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && root.child('relog/overlay').child(root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val()).child('room').val() == $room && (!newData.exists() || (newData.child('by').val() == root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() && (!data.exists() || data.child('by').val() == root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val()))))",
              ".validate": "newData.hasChildren(['type', 'by', 'color', 'x', 'y', 'size', 'fade', 'ts', 'end']) && ((newData.child('type').val() == 'text' && newData.child('text').exists()) || (newData.child('type').val() == 'gif' && newData.child('url').exists()))",
              "type": {
                ".validate": "newData.val() == 'text' || newData.val() == 'gif'"
              },
              "by": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "color": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{3,8}$/)"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
              },
              "size": {
                ".validate": "newData.isNumber() && newData.val() >= 8 && newData.val() <= 900"
              },
              "text": {
                ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().length >= 1"
              },
              "url": {
                ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^https:\\/\\/(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com|cdn\\.discordapp\\.com|media\\.discordapp\\.net|i\\.imgur\\.com)\\//)"
              },
              "fade": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
              },
              "ts": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "end": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              },
              "sticker": {
                ".validate": "newData.isBoolean()"
              }
            }
          },
          "cursors": {
            "$actor": {
              ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() == $actor) && (!newData.exists() || root.child('relog/overlay').child(root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val()).child('room').val() == $room)",
              ".validate": "newData.hasChildren(['x', 'y', 'ts', 'on', 'color', 'name'])",
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
              },
              "ts": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "on": {
                ".validate": "newData.isBoolean()"
              },
              "color": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{3,8}$/)"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          },
          "video": {
            ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || ((auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && root.child('relog/overlay').child(root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val()).child('room').val() == $room)",
            ".validate": "newData.hasChildren(['videoId', 'by', 'state', 'position', 'updatedAt', 'cell', 'width']) && (((!newData.child('source').exists() || newData.child('source').val() == 'youtube') && newData.child('videoId').val().matches(/^[A-Za-z0-9_-]{11}$/)) || (newData.child('source').val() == 'twitch-vod' && newData.child('videoId').val().matches(/^[0-9]{5,12}$/)) || (newData.child('source').val() == 'twitch-clip' && newData.child('videoId').val().matches(/^[A-Za-z0-9_-]{3,100}$/)) || (newData.child('source').val() == 'file' && newData.child('videoId').val().matches(/^https:\\/\\/(video\\.twimg\\.com|cdn\\.discordapp\\.com|media\\.discordapp\\.net|i\\.imgur\\.com)\\//)))",
            "videoId": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "by": {
              ".validate": "newData.isString() && (newData.val() == data.val() || newData.val() == root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val())"
            },
            "state": {
              ".validate": "newData.val() == 'playing' || newData.val() == 'paused'"
            },
            "position": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "cell": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
            },
            "width": {
              ".validate": "newData.isNumber() && newData.val() >= 200 && newData.val() <= 1920"
            },
            "source": {
              ".validate": "newData.val() == 'youtube' || newData.val() == 'twitch-vod' || newData.val() == 'twitch-clip' || newData.val() == 'file'"
            },
            "style": {
              ".validate": "newData.val() == 'kos' || newData.val() == 'plain'"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "live_data": {
      ".read": true,
      "$actor": {
        ".write": "(auth != null && auth.token.email_verified == true && root.child('auth/owner').val() == auth.token.email.toLowerCase().replace('.', ',')) || (auth != null && auth.token.email_verified == true && root.child('auth/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('actorId').val() == $actor)"
      }
    }
  }
}