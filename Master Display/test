/* 1. On cache tout le monde par défaut */
li.voice-state { 
    display: none !important; 
}

/* 2. On affiche UNIQUEMENT Saitho via son ID */
li.voice-state[data-reactid*="DISCORD_USER_ID"] { 
    display: flex !important;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: none !important;
    background: none !important;
}

/* 3. On remplace son avatar par ton image IDLE */
li.voice-state[data-reactid*="DISCORD_USER_ID"] img.avatar {
    content: url("file:///E:/Dev/Twitch/Master Display/saitho_smug.png"); /* METS TON CHEMIN ICI */
    width: 250px !important;
    height: 250px !important;
    border-radius: 0% !important; /* Pour garder l'image carrée/rectangulaire */
    filter: contrast(1.3) sepia(0.2) brightness(0.8); /* Effet VHS de base */
    image-rendering: pixelated; /* Pixellisation Saitho */
}

/* 4. Quand il parle, on change pour l'image TALK */
li.voice-state.speaking[data-reactid*="DISCORD_USER_ID"] img.avatar {
    content: url("file:///E:/Dev/Twitch/Master Display/saitho_talk.png"); /* METS TON CHEMIN ICI */
    filter: contrast(1.1) brightness(1.2) drop-shadow(0 0 15px #0FF) !important;
    transform: scale(1.05);
}

/* 5. On cache le nom, les points et le fond moche de Discord */
.user-name, .voice-dots, .avatar-back { 
    display: none !important; 
}
body { background-color: rgba(0, 0, 0, 0) !important; overflow: hidden; }